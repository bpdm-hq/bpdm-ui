{
  "name": "@bpdm/ui",
  "version": "0.1.0",
  "description": "A modern, themeable, accessible React component library — Radix primitives, Tailwind 4, and a warm amber design system.",
  "type": "module",
  "license": "MIT",
  "author": "Bhavin P. Devamorari (https://bpdm.dev)",
  "homepage": "https://bpdm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BDev-9/bpdm-ui.git"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "tailwindcss",
    "radix-ui",
    "accessible",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp src/styles/tokens.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "storybook": "storybook dev -p 6003",
    "build-storybook": "storybook build"
  },
  "packageManager": "pnpm@10.12.1",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.2",
    "bignumber.js": "^11.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
