{
  "name": "bpdm-ui",
  "version": "0.0.0",
  "private": true,
  "description": "bpdm design system — a monorepo of framework implementations sharing one set of design tokens.",
  "license": "MIT",
  "author": "bpdm (https://bpdm.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpdm-hq/bpdm-ui.git"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "size": "turbo run size",
    "build-storybook": "turbo run build-storybook",
    "build:site": "turbo run build-storybook && pnpm --filter @bpdm/landing build && node scripts/assemble-site.mjs",
    "storybook": "pnpm --filter @bpdm/ui storybook"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "sharp": ">=0.35.5",
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "nanoid": ">=3.3.18",
      "js-yaml": ">=4.3.2",
      "immutable": ">=5.1.8"
    }
  }
}
