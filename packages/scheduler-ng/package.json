{
  "name": "@bpdm/ng-scheduler",
  "version": "0.1.0",
  "description": "Angular scheduler/calendar for the bpdm design system — day, week and month views over one shared headless core. Typed, themeable, accessible, responsive.",
  "license": "MIT",
  "author": "bpdm (https://bpdm.dev)",
  "homepage": "https://ui.bpdm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpdm-hq/bpdm-ui.git",
    "directory": "packages/scheduler-ng"
  },
  "keywords": [
    "scheduler",
    "calendar",
    "angular",
    "design-system",
    "events",
    "responsive",
    "accessible",
    "typescript"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json && cp ../scheduler/src/scheduler.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "test": "ng test --no-watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@bpdm/scheduler-core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@bpdm/scheduler-core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.2.5",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "zone.js": "^0.15.1"
  }
}
