    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "prepublishOnly": "pnpm build",
    "storybook": "storybook dev -p 8100",
    "build-storybook": "storybook build",
    "test:a11y:browser": "storybook build --quiet && concurrently -k -s first -n SB,AXE \"http-server storybook-static -p 8010 -s\" \"wait-on -t 60000 http-get://127.0.0.1:8010/index.json && test-storybook --url http://127.0.0.1:8010\""
